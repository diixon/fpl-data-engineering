# Copy this file to .env and adjust. The real .env is git-ignored - never commit it.
# These are LOCAL DEVELOPMENT values only.

# Database credentials (used by docker-compose AND by scripts run from my machine)
DB_NAME=fpl_db
DB_USER=fpl_user
DB_PASSWORD=fpl_password

# Where my Python scripts find the database:
#   - localhost : when I run a script directly on my machine (python -m src....)
#   - inside Docker the compose file sets this to "postgres" by itself
DB_HOST=localhost
DB_PORT=5432

# Cloud only (see docs/azure_deployment.md): address of the managed PostgreSQL server.
# Leave unset locally - containers then use the "postgres" container.
# DOCKER_DB_HOST=my-server.postgres.database.azure.com

# Optional: change the port on MY machine if 5432 is already used by another Postgres
# POSTGRES_HOST_PORT=5433

# REQUIRED: password of the Airflow admin user (username: admin).
# docker compose stops with an error if this is missing.
# Local development: any simple value is fine. On a server: a strong one.
AIRFLOW_ADMIN_PASSWORD=change-me

# Optional on a laptop, set on a server: key that encrypts Airflow connections/variables.
# Linux/Mac/Git Bash: openssl rand -base64 32 | tr '+/' '-_'
# AIRFLOW_FERNET_KEY=

# Optional: Airflow webserver secret (the compose file has a local-only default)
# AIRFLOW_WEBSERVER_SECRET_KEY=change-me

# Airflow user id inside the container (50000 works on Windows/Mac; on Linux use `id -u`)
AIRFLOW_UID=50000
